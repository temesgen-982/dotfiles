[global]
    width = 300
    height = 300
    origin = top-right
    offset = 10x50
    frame_width = 2
    frame_color = "#89b4fa"
    font = monospace 11
    corner_radius = 8
    padding = 12
    horizontal_padding = 12

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 5

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 8

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
